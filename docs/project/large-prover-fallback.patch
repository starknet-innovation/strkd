+/// Which prover `prove` uses, from `SNIP36_PROVER_MODE` (snip-36-prover-backend patch).
+///
+/// - `auto` (default): the small recursive prover, falling back to the large prover when the
+///   trace does not fit (the small prover's fixed twiddle domain caps each component at 2^20
+///   rows and fails with "Not enough twiddles").
+/// - `small`: the small prover only (stock behaviour).
+/// - `large`: the large prover only.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum ProverMode {
+    Auto,
+    Small,
+    Large,
+}
+
+fn prover_mode() -> ProverMode {
+    match std::env::var("SNIP36_PROVER_MODE").as_deref() {
+        Ok("small") => ProverMode::Small,
+        Ok("large") => ProverMode::Large,
+        _ => ProverMode::Auto,
+    }
+}
+
+/// Runs a prover, turning a panic into an error so the caller can fall back.
+fn run_catching(
+    f: impl FnOnce() -> Result<PrivacyProofOutput, Box<dyn std::error::Error>>,
+) -> Result<PrivacyProofOutput, String> {
+    match catch_unwind(AssertUnwindSafe(f)) {
+        Ok(result) => result.map_err(|e| e.to_string()),
+        Err(panic) => Err(panic
+            .downcast_ref::<String>()
+            .cloned()
+            .or_else(|| panic.downcast_ref::<&str>().map(|s| s.to_string()))
+            .unwrap_or_else(|| "prover panicked".to_string())),
+    }
+}
+
+/// Whether a small-prover failure means the trace is too large for it.
+fn is_capacity_error(message: &str) -> bool {
+    message.contains("twiddles")
+}
+
+fn prove_blocking(
+    cairo_pie: CairoPie,
+    precomputes: Arc<RecursiveProverPrecomputes>,
+    mode: ProverMode,
+) -> Result<PrivacyProofOutput, String> {
+    match mode {
+        ProverMode::Small => run_catching(|| privacy_recursive_prove(cairo_pie, precomputes)),
+        ProverMode::Large => {
+            info!("Proving with the large prover (SNIP36_PROVER_MODE=large)");
+            run_catching(|| privacy_recursive_prove_large(cairo_pie))
+        }
+        ProverMode::Auto => {
+            let fallback_pie = cairo_pie.clone();
+            match run_catching(|| privacy_recursive_prove(cairo_pie, precomputes)) {
+                Err(message) if is_capacity_error(&message) => {
+                    warn!("Small prover out of capacity ({message}); retrying with the large prover");
+                    run_catching(|| privacy_recursive_prove_large(fallback_pie))
+                }
+                other => other,
+            }
+        }
+    }
+}
